# MySQL
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=silvalde_web_db
MYSQL_USER=app_user
MYSQL_PASSWORD=change_this_user_password

# Backend datasource
SPRING_DATASOURCE_USERNAME=app_user
SPRING_DATASOURCE_PASSWORD=change_this_user_password

# JWT — REQUIRED. Generate with: openssl rand -base64 64
# Min 32 bytes. Must differ from any default.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120
JWT_ISSUER=silvalde-web

# Seed users (DataSeeder) — REQUIRED. Must NOT be the default placeholders.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change_me_admin_password
APP_ADMIN_ROLES=ADMIN
APP_CUSTOMER_EMAIL=customer@example.com
APP_CUSTOMER_PASSWORD=change_me_customer_password
APP_CUSTOMER_ROLES=USER
